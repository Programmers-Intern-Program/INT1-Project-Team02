# Discord bot token (Developer Portal > Bot > Reset Token)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flodiback
DB_USERNAME=flodiback
DB_PASSWORD=flodiback
REDIS_HOST=localhost
REDIS_PORT=6379
DISCORD_TOKEN=your_discord_bot_token

# Text command prefix
DISCORD_BOT_PREFIX=!
GLM_ENABLED=false

# Spring internal API base URL (로컬 실행 기준)
# 로컬에서 봇을 직접 실행하면 http://localhost:8080
# Docker에서 봇을 실행하고 Spring 서버는 호스트 Mac에서 실행하면 http://host.docker.internal:8080
INTERNAL_API_BASE_URL=http://localhost:8080

# Optional: internal API key (필요한 경우만)
INTERNAL_API_KEY=

# OpenAI Realtime STT
OPENAI_API_KEY=your_openai_api_key
OPENAI_REALTIME_WS_URL=wss://api.openai.com/v1/realtime?intent=transcription
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# OpenAI Embeddings
OPENAI_EMBEDDING_API_KEY=your_openai_embedding_api_key

OPENAI_TRANSCRIBE_LANGUAGE=ko
GLM_API_KEY=your_glm_api_key
GLM_MODEL=glm-5.1
GLM_API_URL=grepp_url
GLM_TIMEOUT_MS=30000
GLM_MAX_RETRIES=1

# STT debug dump (기본 off)
STT_DEBUG_DUMP_WAV=false
STT_DEBUG_DUMP_DIR=debug/stt-pcm
STT_DEBUG_DUMP_SECONDS=5
