map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# HTTP 서버: HTTPS 리다이렉트 전용.
# certbot webroot 인증 챌린지(/well-known/acme-challenge)만 예외로 처리한다.
# /nginx-health는 deploy 스크립트의 nginx 헬스체크 전용 엔드포인트다.
# HTTPS 인증서가 없어도 80 포트는 항상 응답해야 하므로 별도 서버 블록으로 분리한다.
server {
    listen 80;
    server_name ${NGINX_DOMAIN};

    location = /nginx-health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS 서버: 실제 백엔드 프록시 처리.
# 인증서는 EC2 호스트에서 certbot으로 발급 후 /etc/letsencrypt에 위치한다.
# upstream flodi_backend는 deploy/nginx/conf.d/upstream.conf에서 blue/green 슬롯을 동적으로 지정한다.
server {
    listen 443 ssl;
    server_name ${NGINX_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${NGINX_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${NGINX_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    location = /nginx-health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location / {
        proxy_pass http://flodi_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # WebSocket 업그레이드 헤더: Discord 봇 연결 등 ws:// 통신에 필요하다.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout 5s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }
}
